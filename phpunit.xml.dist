<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         failOnWarning="true">
    <testsuites>
        <!-- One class at a time: models, services and their contracts. -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Whole requests through the admin panel, API and artisan commands. -->
        <testsuite name="Feature">
            <directory>tests</directory>
            <exclude>tests/Unit</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
            <directory>core</directory>
        </include>
        <exclude>
            <directory>src/assets</directory>
            <directory>src/views</directory>
            <directory>core/resources</directory>
            <directory>core/Console/stubs</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_KEY" value="base64:2fl+Ktvkfl+Fuz4Qp/A75G2RTiWVA/ZoKZvp6fiiM10="/>
        <env name="DB_CONNECTION" value="testing"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
