<?php

namespace {{ namespace }};

use {{ modelClass }};
use CrudBooster\Forms\Fields;
use CrudBooster\Forms\Form;
use CrudBooster\Resources\Resource;
use CrudBooster\Tables\Columns;
use CrudBooster\Tables\Table;

class {{ class }} extends Resource
{
    protected static string $model = {{ model }}::class;

    protected static ?string $navigationIcon = 'fa fa-circle-o';

    protected static ?string $recordTitleAttribute = {{ titleAttribute }};

    public function table(Table $table): Table
    {
        return $table
            ->columns([
{{ columns }}
            ]);
    }

    public function form(Form $form): Form
    {
        return $form->schema([
{{ fields }}
        ]);
    }
}
