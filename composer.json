{
    "name": "crocodicstudio/crudbooster",
    "description": "CRUDBooster Is CRUD Generator Based On Laravel Easy To Make An Advanced Backend",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "admin-panel",
        "backend",
        "crud-generator",
        "crudbooster",
        "crud",
        "generator"
    ],
    "authors": [
        {
            "name": "Ferry",
            "email": "ferry@crocodic.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "maatwebsite/excel": "^3.1.70|^4.0",
        "intervention/image": "^3.11",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "crocodicstudio\\crudbooster\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "crocodicstudio\\crudbooster\\tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "crocodicstudio\\crudbooster\\CRUDBoosterServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
