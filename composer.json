{
    "name": "vicheanath/crudbooster",
    "description": "CRUDBooster (classic 5.x architecture) maintained for PHP 8.2+ and Laravel 12/13 - CRUD generator for an advanced Laravel backend",
    "homepage": "https://github.com/vicheanath/crudbooster-contrib",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "admin-panel",
        "backend",
        "crud-generator",
        "crudbooster",
        "crud",
        "generator"
    ],
    "authors": [
        {
            "name": "Ferry",
            "email": "ferry@crocodic.com",
            "role": "Original author"
        },
        {
            "name": "Vichea",
            "homepage": "https://github.com/vicheanath",
            "role": "Maintainer"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "maatwebsite/excel": "^3.1.70|^4.0",
        "intervention/image": "^3.11",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "conflict": {
        "crocodicstudio/crudbooster": "*"
    },
    "autoload": {
        "psr-4": {
            "crocodicstudio\\crudbooster\\": "src/",
            "CrudBooster\\": "core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "crocodicstudio\\crudbooster\\tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "crocodicstudio\\crudbooster\\CRUDBoosterServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:coverage": "phpunit --coverage-text --coverage-html build/coverage",
        "test:mysql": [
            "@putenv CB_TEST_DB=mysql",
            "@putenv DB_HOST=127.0.0.1",
            "@putenv DB_PORT=3307",
            "@putenv DB_DATABASE=crudbooster_test",
            "@putenv DB_USERNAME=crudbooster",
            "@putenv DB_PASSWORD=secret",
            "phpunit"
        ]
    },
    "config": {
        "sort-packages": true,
        "process-timeout": 0
    },
    "support": {
        "issues": "https://github.com/vicheanath/crudbooster-contrib/issues",
        "source": "https://github.com/vicheanath/crudbooster-contrib"
    },
    "scripts-descriptions": {
        "test": "Run the test suite on SQLite",
        "test:unit": "Run only the unit tests (models and services)",
        "test:coverage": "Run the tests with a coverage report (needs pcov or Xdebug), HTML in build/coverage",
        "test:mysql": "Run the test suite on the docker-compose MySQL service"
    }
}
