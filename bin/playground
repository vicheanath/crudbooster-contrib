#!/usr/bin/env php
<?php

/*
| Local Laravel app for developing CRUDBooster.
|
| Creates ./playground (git-ignored), a real Laravel application that requires this
| repository through a Composer path repository with a symlink, so edits in src/
| show up immediately. Run `php bin/playground help` for the commands.
*/

const PROVIDER = 'crocodicstudio\\crudbooster\\CRUDBoosterServiceProvider';

$root = dirname(__DIR__);
$app = $root.DIRECTORY_SEPARATOR.'playground';

[$command, $options] = parseArgs(array_slice($argv, 1));

switch ($command) {
    case 'setup':
        setup($root, $app, $options);
        break;
    case 'serve':
        requireApp($app);
        run(['php', 'artisan', 'serve', '--port='.($options['port'] ?? '8000')], $app);
        break;
    case 'publish':
        requireApp($app);
        publish($app, true);
        break;
    case 'fresh':
        requireApp($app);
        run(['php', 'artisan', 'migrate:fresh', '--force'], $app);
        seed($app);
        loginInfo($options);
        break;
    case 'artisan':
        requireApp($app);
        run(array_merge(['php', 'artisan'], $options['_'] ?? []), $app);
        break;
    case 'destroy':
        if (is_dir($app)) {
            removeDir($app);
            info('Removed playground/.');
        }
        break;
    default:
        help();
}

function setup($root, $app, array $options)
{
    if (is_dir($app)) {
        if (! isset($options['force'])) {
            fail("playground/ already exists. Use `php bin/playground fresh` to reset the database, or `setup --force` to rebuild it.");
        }
        removeDir($app);
    }

    $laravel = $options['laravel'] ?? '13';
    info("Creating a Laravel $laravel app in playground/ ...");
    run(['composer', 'create-project', "laravel/laravel:^$laravel.0", 'playground', '--prefer-dist', '--no-interaction'], $root);

    info('Linking this repository as vicheanath/crudbooster ...');
    run(['composer', 'config', 'repositories.crudbooster', json_encode([
        'type' => 'path',
        'url' => '..',
        'options' => ['symlink' => true],
    ])], $app);
    run(['composer', 'config', 'minimum-stability', 'dev'], $app);
    run(['composer', 'config', 'prefer-stable', 'true'], $app);
    run(['composer', 'require', 'vicheanath/crudbooster:*@dev', '--with-all-dependencies', '--no-interaction'], $app);

    configureEnv($app, $options);

    publish($app, false);
    run(['php', 'artisan', 'migrate', '--force'], $app);
    seed($app);

    info('Playground ready. Start it with: php bin/playground serve');
    loginInfo($options);
}

function configureEnv($app, array $options)
{
    $env = [
        'APP_NAME' => 'CRUDBooster',
        'APP_URL' => 'http://127.0.0.1:'.($options['port'] ?? '8000'),
    ];

    if (isset($options['mysql'])) {
        // Matches the `mysql` service in docker-compose.yml.
        $env += [
            'DB_CONNECTION' => 'mysql',
            'DB_HOST' => '127.0.0.1',
            'DB_PORT' => '3307',
            'DB_DATABASE' => 'crudbooster',
            'DB_USERNAME' => 'crudbooster',
            'DB_PASSWORD' => 'secret',
        ];
    }

    if (isset($options['mailpit'])) {
        // Matches the `mailpit` service in docker-compose.yml; inbox at http://localhost:8025
        $env += [
            'MAIL_MAILER' => 'smtp',
            'MAIL_HOST' => '127.0.0.1',
            'MAIL_PORT' => '1025',
            'MAIL_FROM_ADDRESS' => 'crudbooster@example.com',
        ];
    }

    $file = $app.DIRECTORY_SEPARATOR.'.env';
    $contents = file_get_contents($file);
    foreach ($env as $key => $value) {
        $line = $key.'='.$value;
        // The skeleton ships some keys commented out (e.g. "# DB_HOST=127.0.0.1").
        $pattern = '/^#?\s*'.preg_quote($key, '/').'=.*$/m';
        $contents = preg_match($pattern, $contents) ? preg_replace($pattern, $line, $contents, 1) : rtrim($contents)."\n".$line."\n";
    }
    file_put_contents($file, $contents);
}

function publish($app, $assetsOnly)
{
    if ($assetsOnly) {
        // Assets are copied, not symlinked: re-run after changing src/assets.
        run(['php', 'artisan', 'vendor:publish', '--tag=cb_asset', '--force'], $app);
    } else {
        run(['php', 'artisan', 'vendor:publish', '--provider='.PROVIDER], $app);
    }
}

function seed($app)
{
    run(['php', 'artisan', 'db:seed', '--class=CBSeeder', '--force'], $app);
}

function loginInfo(array $options)
{
    $port = $options['port'] ?? '8000';
    echo "\n  Admin:    http://127.0.0.1:$port/admin/login\n";
    echo "  Email:    admin@crudbooster.com\n";
    echo "  Password: 123456\n\n";
}

function help()
{
    echo <<<'TXT'
CRUDBooster playground: a local Laravel app wired to this repository.

Usage: php bin/playground <command> [options]

  setup      Create playground/ and install CRUDBooster into it
               --laravel=12|13   Laravel major version (default 13)
               --mysql           Use the MySQL service from docker-compose.yml (default: SQLite)
               --mailpit         Send mail to the Mailpit service from docker-compose.yml
               --force           Delete and rebuild an existing playground/
  serve      Run `php artisan serve` (--port=8000)
  publish    Re-publish CRUDBooster assets after editing src/assets
  fresh      Drop all tables, migrate and seed the default admin again
  artisan    Run any artisan command in the playground, e.g. `artisan -- route:list`
  destroy    Delete playground/

TXT;
}

function parseArgs(array $args)
{
    $command = 'help';
    $options = [];
    $passthrough = false;
    foreach ($args as $arg) {
        if ($passthrough) {
            $options['_'][] = $arg;
        } elseif ($arg === '--') {
            $passthrough = true;
        } elseif (strncmp($arg, '--', 2) === 0) {
            [$key, $value] = array_pad(explode('=', substr($arg, 2), 2), 2, true);
            $options[$key] = $value;
        } elseif ($command === 'help') {
            $command = $arg;
        } else {
            $options['_'][] = $arg;
        }
    }

    return [$command, $options];
}

function run(array $command, $cwd)
{
    $line = implode(' ', array_map('escapeshellarg', $command));
    echo "\n> $line\n";
    $process = proc_open($line, [STDIN, STDOUT, STDERR], $pipes, $cwd);
    $code = is_resource($process) ? proc_close($process) : 1;
    if ($code !== 0) {
        fail("Command failed ($code): $line");
    }
}

function requireApp($app)
{
    if (! is_file($app.DIRECTORY_SEPARATOR.'artisan')) {
        fail('No playground yet. Create it with: php bin/playground setup');
    }
}

function removeDir($dir)
{
    if (is_link($dir) || is_file($dir)) {
        unlink($dir);
        return;
    }
    foreach (scandir($dir) as $item) {
        if ($item !== '.' && $item !== '..') {
            $path = $dir.DIRECTORY_SEPARATOR.$item;
            // Never follow the symlink back into this repository.
            is_link($path) || ! is_dir($path) ? unlink($path) : removeDir($path);
        }
    }
    rmdir($dir);
}

function info($message)
{
    echo "\n\033[32m$message\033[0m\n";
}

function fail($message)
{
    fwrite(STDERR, "\n\033[31m$message\033[0m\n");
    exit(1);
}
